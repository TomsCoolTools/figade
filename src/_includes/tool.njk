---
layout: base.njk
workspace: true
scripts: ["/js/file-options.js", "/js/tool-ui.js", "/js/app.js"]
---
{# tool.njk — Layout for any page with the compressor on it.
  A page using this supplies only its own words in the front matter. #}
<h1>{{ h1 }}</h1>
<p class="s">{{ intro | safe }}</p>
{%- if limit %}
<div class="limit"><b>{{ limit.big }}</b><span>{{ limit.caption }}{% if limit.checked %}, checked {{ site.checked }}{% endif %}</span></div>
{%- endif %}
{% include "partials/compressor.njk" %}
<section class="supporting" aria-label="Help and related tools">
<div class="supporting-grid">
<div class="supporting-links">
<p class="also">Need to shrink a photo instead? <a href="/compress-image">Compress an image</a></p>
{% include "partials/sizelinks.njk" %}
{{ content | safe }}
{%- if fitsTable %}
<h2>How long a video fits in {{ target }}MB</h2>
<div class="tw">
  <table>
    <caption>Longest 16:9 clip that stays at each resolution. More sizes in the <a href="/video-size-guide">size guide</a>.</caption>
    <thead><tr><th scope="col">Resolution</th><th scope="col">Up to</th></tr></thead>
    <tbody>
      {%- for f in target | fits %}
      <tr><th scope="row">{{ f.res }}</th><td>{{ f.time }}</td></tr>
      {%- endfor %}
    </tbody>
  </table>
</div>
{%- endif %}
</div>
<section class="supporting-guide">
{%- if facts %}
<h2>What to know</h2>
<ul>
  {%- for f in facts %}
  <li>{{ f | safe }}</li>
  {%- endfor %}
</ul>
{%- endif %}
</section>
<section class="supporting-questions">
<h2>Questions</h2>
<div class="faq-list">
  {%- for item in faq %}
  <details><summary>{{ item.q }}</summary><p>{{ item.a }}</p></details>
  {%- endfor %}
</div>
</section>
</div></section>
<script type="application/ld+json">{{ { page: page, site: site, h1: h1, description: description, faq: faq } | toolSchema | safe }}</script>
