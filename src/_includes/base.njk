{#
  base.njk — the shell every page uses: head, menu, footer.
  Change something here and it changes on every page, in every language.
#}<!doctype html>
<html lang="{{ lang or 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- set cpath = canonical or (page.url | replace(".html", "") | replace("/index", "/")) %}
    <meta name="robots" content="{% if noindex %}noindex{% else %}max-image-preview:large, max-snippet:-1{% endif %}">
    <title>{{ title }}{% if site.name not in title %} | {{ site.name }}{% endif %}</title>
    <meta name="description" content="{{ description }}">
    {%- if not noindex %}
    <link rel="canonical" href="{{ site.url }}{{ cpath }}">
    {%- endif %}
    <link rel="icon" href="{{ '/favicon.ico' | v }}" sizes="48x48">
    <link rel="icon" href="{{ '/favicon.svg' | v }}" type="image/svg+xml">
    <link rel="icon" type="image/png" sizes="96x96" href="{{ '/img/favicon-96x96.png' | v }}">
    <link rel="icon" type="image/png" sizes="192x192" href="{{ '/img/android-chrome-192x192.png' | v }}">
    <link rel="apple-touch-icon" href="{{ '/img/apple-touch-icon.png' | v }}">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="{{ site.themeColor }}" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="{{ site.themeColorDark }}" media="(prefers-color-scheme: dark)">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="{{ site.url }}{{ cpath }}">
    <meta property="og:locale" content="en_GB">
    <meta property="og:image" content="{{ site.url }}{{ '/img/og.png' | v }}">
    <meta property="og:image:alt" content="{{ site.name }}: shrink a video to the size you need">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    {%- if site.bingVerification and page.url == "/" %}
    <meta name="msvalidate.01" content="{{ site.bingVerification }}" />
    {%- endif %}
    <link rel="preload" href="/fonts/figade-serif-600.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ '/css/style.css' | v }}">
    {%- if site.adsenseClient %}
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ site.adsenseClient }}" crossorigin="anonymous"></script>
    {%- endif %}
  </head>
  <body>
    <header class="top">
      <div class="wrap">{% include "partials/nav.njk" %}</div>
    </header>
    <main class="wrap{% if textPage %} text{% endif %}">
      {{ content | safe }}
    </main>
    {% include "partials/footer.njk" %}
    {%- if site.goatcounter %}
    <script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
    {%- endif %}
    {%- if scripts %}
    {% for s in scripts %}<script src="{{ s | v }}"></script>
    {% endfor %}
    {%- endif %}
  </body>
</html>
