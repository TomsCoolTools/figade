{# The footer. Edit the links in src/_data/footerLinks.json. #}
<footer>
  <div class="wrap">
    <p>{{ site.name }} shrinks videos and images to the size you need, on your own device. Limits last checked {{ site.checked }}. They change, so check the app if a file is refused.</p>
    <p class="fl">
      {%- for item in footerLinks %}
      <a href="{{ item.url }}">{{ item.label }}</a>
      {%- endfor %}
    </p>
  </div>
</footer>
