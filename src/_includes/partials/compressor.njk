{# The compressor box. Do not rename the ids — js/app.js needs them. #}
<div class="tool">
  <label for="file">Video <span class="hint">or drop one anywhere on this page</span></label>
  <input id="file" type="file" accept="video/*">
  <label for="mb">Target size</label>
  <div class="row">
    {%- for mb in chips %}
    <button class="chip{% if mb == target %} on{% endif %}" data-mb="{{ mb }}">{{ mb }}MB</button>
    {%- endfor %}
  </div>
  <div class="num"><input id="mb" type="number" min="1" step="0.5" value="{{ target }}"><span>MB</span></div>
  <p id="est" aria-live="polite"></p>
  <button id="go">Compress</button>
  <div id="bar"><i></i></div>
  <p id="st" aria-live="polite"></p>
  <div id="out"></div>
  <details>
    <summary>Details</summary>
    <pre id="log">Nothing yet.</pre>
  </details>
</div>
