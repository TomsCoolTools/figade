{# The menu. Edit the links in src/_data/nav.json, not here. #}
<nav>
  <a class="brand" href="/">{{ site.name }}</a>
  {%- for item in nav %}
  <a class="l" href="{{ item.url }}"{% if (page.url | replace(".html", "")) == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
  {%- endfor %}
</nav>
