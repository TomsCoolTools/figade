{# Links to the other size pages. The list lives in src/_data/sizes.json. #}
<h2 class="more-h">{{ sizesHeading or "Other sizes" }}</h2>
<div class="more">
  {%- for s in sizes %}
  {%- if s.key == toolKey %}
  <span>{{ s.label }}</span>
  {%- else %}
  <a href="{{ s.url }}">{{ s.label }}</a>
  {%- endif %}
  {%- endfor %}
</div>
