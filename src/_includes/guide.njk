---
layout: base.njk
textPage: true
---
{# guide.njk — Layout for a guide. Each guide ends by pointing to the tool that solves the problem. #}
<div class="{{ 'reference-content' if wideContent else 'reading-content' }}">
<h1>{{ h1 }}</h1>
<p class="guide-byline">By <a href="/about">Tom</a></p>
{{ content | safe }}
{%- if tool %}
<p class="next"><a href="{{ tool.url }}">{{ tool.label }}</a></p>
{%- endif %}
<p class="s">More in <a href="/guides/">Guides</a>.</p>
</div>
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": h1,
  "description": description,
  "url": site.url + page.url | replace(".html", ""),
  "dateModified": page.date | isoDate,
  "author": { "@type": "Person", "name": "Tom", "url": site.url + "/about" },
  "publisher": { "@type": "Organization", "name": site.name, "url": site.url + "/" }
} | dump | replace("<", "\\u003c") | safe }}</script>
